{
	"schemaVersion": 1,
	"id": "lootableblocks",
	"version": "${version}",
	"name": "Lootable Blocks",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"TheRedBrain"
	],
	"contact": {
		"sources": "https://github.com/TheRedBrain/lootable-blocks"
	},
	"license": "MIT",
	"icon": "assets/lootableblocks/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.github.theredbrain.lootableblocks.LootableBlocks"
		],
		"client": [
			"com.github.theredbrain.lootableblocks.LootableBlocksClient"
		]
	},
	"mixins": [
      "lootableblocks.mixins.json",
		{
			"config": "lootableblocks.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_version}",
		"fabric-api": "*",
		"fzzy_config": ">=${fzzy_config_version}"
	},
	"suggests": {
		"lootables": "*",
		"loot_n_explore": "*"
  }
}